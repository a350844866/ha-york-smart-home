          "password": "Phone number and password",
          "sms": "SMS verification code"
        }
      },
      "password": {
        "title": "Phone number and password",
        "data": {
          "phone": "Phone number",
          "password": "Password"
        },
        "data_description": {
          "password": "Recommended: the session is renewed automatically with the password."
        }
      },
      "sms": {
        "title": "SMS verification code",
        "description": "A verification code will be sent to this phone.",
        "data": {
          "phone": "Phone number"
        }
      },
      "sms_code": {
        "title": "SMS verification code",
        "description": "Enter the code sent to {phone}.",
        "data": {
          "verify_code": "Verification code"
        }
      }
    },
    "error": {
      "invalid_auth": "Wrong phone number, password or verification code.",
      "cannot_connect": "Cannot connect to the York cloud.",
