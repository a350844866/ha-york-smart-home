  "config": {
    "step": {
      "user": {
        "title": "York Smart Home",
        "description": "Log in with your York Smart Home (约克智慧家) app account.",
        "menu_options": {
          "password": "Phone number and password",
          "sms": "SMS verification code"
        }
      },
      "reauth": {
        "title": "Log in again",
        "description": "The saved session expired and could not be renewed automatically.",
