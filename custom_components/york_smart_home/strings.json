      "unknown": "Unexpected error, see the log.",
      "login_rejected": "The York cloud rejected the login: {message}",
      "client_outdated": "The York cloud requires a newer app version; see the integration's documentation."
    },
    "abort": {
      "already_configured": "This account is already configured.",
      "reauth_successful": "Logged in again successfully.",
      "wrong_account": "That login belongs to a different account."
