  "options": {
    "step": {
      "init": {
        "data": {
          "scan_interval": "Polling interval (seconds)",
          "reclaim_session": "Always take the session back",
          "session_yield_minutes": "Leave the session to the other device for (minutes)"
        },
        "data_description": {
          "reclaim_session": "The York account allows one login at a time. Off (recommended): when the app logs in on a phone, Home Assistant stops polling for a while instead of logging the phone out. On: log in again right away (the phone is logged out).",
