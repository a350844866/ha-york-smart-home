  "issues": {
    "session_taken": {
      "title": "York account in use on another device",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "York account in use on another device",
            "description": "The York Smart Home account was logged in on another device (usually the app on a phone), which logged Home Assistant out. The account allows only one login at a time, so Home Assistant has stopped polling for {minutes} minutes instead of logging the other device out; its entities are unavailable meanwhile. It logs in again automatically afterwards.\n\nTo use both at the same time, register a second account, invite it from the app (家庭管理 → 邀请成员, QR code) and log in to Home Assistant with that account.\n\nSubmit below to log in again now; the other device will be logged out."
          }
        },
        "error": {
          "reclaim_failed": "Logging in again failed; see the log."
        },
        "abort": {
          "not_loaded": "The integration is not loaded."
        }
      }
    },
    "client_outdated": {
      "title": "York cloud requires a newer app version",
      "description": "The York cloud rejected the requests with code 300 (app update required). Latest app version: {version}, download: {url}. Polling is paused for an hour and then tried again. Update the integration once a version with the new app version is available."
    }
  }
